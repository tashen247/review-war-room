# Only ANTHROPIC_API_KEY is needed for mock mode. Without it, the offline keyword pipeline runs instead of the agent.
ANTHROPIC_API_KEY=
LEAD_MODEL=claude-sonnet-5-5
SUBAGENT_MODEL=claude-haiku-5-5
MOCK_MODE=true
MAX_BUDGET_USD=0.75
MAX_TURNS=25

# Real reviews (read-only public scraping) - used when MOCK_MODE=false
APP_ID_ANDROID=
APP_ID_IOS=

# Real integrations (optional; each falls back to a mock file under runs/<id>/ when empty)
ASANA_PAT=
ASANA_PROJECT_GID=
SLACK_BOT_TOKEN=
SLACK_WARROOM_CHANNEL_ID=
GOOGLE_SERVICE_ACCOUNT_JSON=
REPLY_QUEUE_SHEET_ID=

SUPPORT_DOMAIN=support.example.com
DB_PATH=./data/warroom.db
PORT=8787
# Docker only: origin the API uses to reach n8n's resume webhook
N8N_INTERNAL_URL=
