{
  "name": "review-war-room",
  "version": "0.1.0",
  "description": "An agent that treats an app's ratings drop like a production incident: release correlation, clustered evidence, deduplicated bugs and approval-gated replies.",
  "type": "module",
  "license": "MIT",
  "author": "Tashen Muthayan",
  "repository": {
    "type": "git",
    "url": "https://github.com/tashen247/review-war-room.git"
  },
  "keywords": [
    "agents",
    "multi-agent",
    "n8n",
    "app-reviews",
    "asana",
    "slack",
    "incident-response",
    "typescript"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "gen": "tsx scripts/gen-reviews.ts",
    "dev": "tsx src/server.ts",
    "start": "tsx src/server.ts",
    "demo": "tsx src/cli.ts demo",
    "investigate": "tsx src/cli.ts investigate",
    "ingest": "tsx src/cli.ts ingest",
    "trace": "tsx scripts/trace.ts",
    "eval": "tsx evals/run.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "approve": "tsx src/cli.ts approve",
    "summary": "tsx src/cli.ts summary",
    "lint": "eslint ."
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.310",
    "@slack/web-api": "^8.2.0",
    "better-sqlite3": "^13.0.3",
    "dotenv": "^18.0.9",
    "fastify": "^5.12.7",
    "googleapis": "^188.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.5",
    "eslint": "^9.39.5",
    "globals": "^17.13.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  },
  "optionalDependencies": {
    "app-store-scraper": "^0.18.0",
    "google-play-scraper": "^10.1.4"
  }
}
